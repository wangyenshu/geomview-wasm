/* Constant shading, but with texture. Alpha channel is honoured. */

surface
GVrgbapaintedconstant(string texturename = "";)
{
  Ci = Cs;
  Oi = Os;
  if (texturename != "") {
    Ci *= color texture (texturename);
    Oi *= float texture (texturename[3], "fill", 1.0, "width", 0.0);
  }
  Ci *= Os;
}

